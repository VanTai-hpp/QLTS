ZALO_SHARED_SECRET="YOUR_ZALO_SHARED_SECRET"
SITE_URL="https://your-site-name.netlify.app"
ZALO_DEFAULT_DRY_RUN="true"

# Netlify Functions - Quản trị Người dùng & Bootstrap Admin
BOOTSTRAP_ADMIN_EMAIL="admin@tuyensinh.edu.vn"
